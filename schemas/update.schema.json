{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ImLogueybear/PocketAppsTCG/main/schemas/update.schema.json",
  "title": "PocketAppsTCG update document",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "type": "string" },
    "version": { "type": ["string", "null"] },
    "build": { "type": "integer", "minimum": 0 },
    "tag": { "type": ["string", "null"] },
    "url": {
      "type": ["string", "null"],
      "description": "Direct, anonymously downloadable artifact URL (the APK). Clients open this to update."
    },
    "releaseUrl": {
      "type": ["string", "null"],
      "description": "Optional human-readable release/changelog page. May require repository access."
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the artifact at `url`, lowercase hex."
    },
    "size": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Exact byte length of the artifact at `url`."
    },
    "notes": { "type": ["string", "null"] },
    "publishedAt": { "type": ["string", "null"] }
  }
}
